function createLead_(payload,source){const ss=crm_(),sheet=ss.getSheetByName(SCI.SHEETS.LEADS),id=newLeadId_(),created=new Date(),services=Array.isArray(payload.services)?payload.services.join(", "):safeText_(payload.services),score=scoreLead_(payload),nextFollowUp=addDays_(created,SCI.FOLLOW_UP_GAPS_DAYS[0]);const row=[id,created,safeText_(source||"unknown"),safeText_(payload.name),safeText_(payload.organization),safeText_(payload.customerType),safeText_(payload.email),safeText_(payload.phone),safeText_(payload.location),services,safeText_(payload.budget),safeText_(payload.timeline),safeText_(payload.preferredContact),safeText_(payload.summary),score,"New","",nextFollowUp,0,"","",safeText_(payload.industrySegment||payload.customerType),safeText_(payload.campaign),safeText_(payload.utmSource),safeText_(payload.utmMedium),safeText_(payload.utmCampaign),safeText_(payload.sourceDetail)];sheet.appendRow(row);appendActivity_(id,"lead_created","system","Lead created from "+safeText_(source)+" | "+safeText_(payload.campaign||payload.utmCampaign));return getLeadById_(id);}
function scoreLead_(payload){let score=10;const type=safeText_(payload.customerType||payload.industrySegment).toLowerCase(),timeline=safeText_(payload.timeline).toLowerCase(),budget=safeText_(payload.budget).toLowerCase(),services=(Array.isArray(payload.services)?payload.services.join(" "):safeText_(payload.services)).toLowerCase();if(["church","house of worship","funeral home","daycare","small business","commercial business","dental / medical office","hvac / plumbing / trade business","nonprofit","school / community facility"].indexOf(type)!==-1)score+=15;if(timeline.indexOf("asap")!==-1||timeline.indexOf("1 week")!==-1)score+=20;else if(timeline.indexOf("30 days")!==-1)score+=12;if(budget.indexOf("25,000+")!==-1)score+=30;else if(budget.indexOf("10,000")!==-1)score+=25;else if(budget.indexOf("5,000")!==-1)score+=18;else if(budget.indexOf("2,500")!==-1)score+=12;["led wall","sound","structured cabling","access control","cctv","live streaming","wifi","network","display"].forEach(function(keyword){if(services.indexOf(keyword)!==-1)score+=4;});if(safeText_(payload.email))score+=5;if(safeText_(payload.phone))score+=5;return Math.min(score,100);}
function getLeadById_(leadId){const leads=getLeadRows_();for(let i=0;i<leads.length;i++)if(leads[i]["Lead ID"]===leadId)return leads[i];return null;}
function getLeadRows_(){const sheet=crm_().getSheetByName(SCI.SHEETS.LEADS),values=sheet.getDataRange().getValues();if(values.length<2)return[];const headers=values[0];return values.slice(1).map(function(row,index){const obj={_row:index+2};headers.forEach(function(header,i){obj[header]=row[i];});return obj;});}
function updateLeadFields_(leadId,updates){const sheet=crm_().getSheetByName(SCI.SHEETS.LEADS),headers=sheet.getRange(1,1,1,sheet.getLastColumn()).getValues()[0],lead=getLeadById_(leadId);if(!lead)throw new Error("Lead not found: "+leadId);Object.keys(updates).forEach(function(key){const index=headers.indexOf(key);if(index!==-1)sheet.getRange(lead._row,index+1).setValue(updates[key]);});}
function appendActivity_(leadId,type,channel,details){const cfg=sciConfig_();if(!cfg.crmSheetId)return;const sheet=SpreadsheetApp.openById(cfg.crmSheetId).getSheetByName(SCI.SHEETS.ACTIVITY);if(sheet)sheet.appendRow([new Date(),safeText_(leadId),safeText_(type),safeText_(channel),safeText_(details)]);}
function newLeadId_(){const stamp=Utilities.formatDate(new Date(),Session.getScriptTimeZone(),"yyyyMMdd-HHmmss"),suffix=Math.floor(Math.random()*900+100);return"SCI-"+stamp+"-"+suffix;}
function addDays_(date,days){const copy=new Date(date.getTime());copy.setDate(copy.getDate()+Number(days||0));return copy;}

